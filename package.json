{
  "name": "anthology",
  "version": "1.8.27",
  "description": "Anthology - Nuvio ve Stremio için Doğrulanmış Türkçe Film, Dizi, Anime ve Canlı TV Eklenti Deposu",
  "main": "config.js",
  "scripts": {
    "build": "node build.js && node scripts/build_stremio_catalogs.js",
    "build:providers": "node build.js",
    "build:watch": "node build.js --watch",
    "serve": "node server.js",
    "test": "node scripts/test_stremio_addon.js && node scripts/test_all_catalogs.js",
    "test:addon": "node scripts/test_stremio_addon.js",
    "test:catalogs": "node scripts/test_all_catalogs.js",
    "test:providers": "node scripts/test_all_providers.js",
    "test:playability": "node scripts/test_playability.js",
    "test:youtube": "node tests/youtube_dizifilm.test.js",
    "test:youtube:live": "node scripts/test_youtube_live.js --live",
    "serve:youtube": "node scripts/serve_youtube_local.js"
  },
  "keywords": [
    "nuvio",
    "stremio",
    "addons",
    "providers",
    "live-tv",
    "turkce"
  ],
  "author": "falsisdev",
  "license": "MIT",
  "dependencies": {
    "cheerio-without-node-native": "^0.20.2",
    "esbuild": "^0.28.2"
  }
}
